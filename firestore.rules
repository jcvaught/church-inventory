rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userChurchId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId;
    }

    function userIsAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Church data — restricted to authenticated users belonging to that church
    match /churches/{churchId}/{document=**} {
      allow read, write: if request.auth != null && userChurchId() == churchId;
    }

    // User profiles — any authenticated user can read (needed for admin user management)
    // Users can write their own profile; admins can update users in their church (role, active)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        (userIsAdmin() && userChurchId() == resource.data.churchId)
      );
    }
  }
}
