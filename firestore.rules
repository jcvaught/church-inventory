rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userChurchId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId;
    }

    function userIsAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Church parent doc — creator and existing members can read directly (get).
    // Any authenticated user can list (needed for the join-by-church-code query).
    // Only the church creator or existing members can write.
    match /churches/{churchId} {
      allow get: if request.auth != null && (
        request.auth.uid + '-church' == churchId ||
        userChurchId() == churchId
      );
      allow list: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid + '-church' == churchId ||
        userChurchId() == churchId
      );
    }

    // Public item requests — anyone can submit; only church members can read/dismiss
    match /churches/{churchId}/publicRequests/{docId} {
      allow create: if true;
      allow read, delete, update: if request.auth != null && userChurchId() == churchId;
    }

    // Church subcollections — restricted to authenticated users belonging to that church
    match /churches/{churchId}/{document=**} {
      allow read, write: if request.auth != null && userChurchId() == churchId;
    }

    // User profiles — own profile always readable; same-church reads allowed (needed for team management)
    // Users can write their own profile; admins can update users in their church (role, active)
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        userChurchId() == resource.data.churchId
      );
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        (userIsAdmin() && userChurchId() == resource.data.churchId)
      );
    }

    // Suggestions — any authenticated user can submit; only app owner can read
    // NOTE: owner emails also defined in functions/index.js (OWNER_EMAILS) and SettingsPage.jsx (isOwner). Keep in sync.
    match /suggestions/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
    }

    // Errors — any authenticated user can write; only app owner can read
    // NOTE: owner emails also defined in functions/index.js (OWNER_EMAILS) and SettingsPage.jsx (isOwner). Keep in sync.
    match /errors/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
    }
  }
}
