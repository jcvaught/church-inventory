rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    // Single get() per request; all helpers derive from it.
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function userChurchId()         { return userData().churchId; }
    function userIsAdmin()          { return userData().role == 'admin'; }
    function userIsAdminOrManager() { return userData().role == 'admin' || userData().role == 'manager'; }
    function isMember(churchId)     { return request.auth != null && userChurchId() == churchId; }
    function isChurchAdmin(churchId)          { return isMember(churchId) && userIsAdmin(); }
    function isChurchAdminOrManager(churchId) { return isMember(churchId) && userIsAdminOrManager(); }

    // ── Church parent doc ─────────────────────────────────────────────────────
    // H-02 / Phase D from the 2026-05-12 audit: `allow list` removed. The
    // join-by-church-code lookup that previously needed list permission is now
    // routed through the `lookupChurchByCode` callable (functions/index.js) so
    // the server returns only the matched churchId and no other data. The
    // self-creator-check at registration uses a direct getDoc on
    // churches/{creator-uid}-church which is permitted by the `allow get`
    // self-creator branch below.
    match /churches/{churchId} {
      allow get:    if request.auth != null && (
                      request.auth.uid + '-church' == churchId ||
                      userChurchId() == churchId
                    );
      allow create: if request.auth != null && request.auth.uid + '-church' == churchId;
      allow update, delete: if isChurchAdmin(churchId);
    }

    // ── Subscription — client create allowed only for church creator (initial setup);
    //    all subsequent writes are done by webhooks via Admin SDK (bypasses rules). ──
    match /churches/{churchId}/config/subscription {
      allow read:   if isMember(churchId);
      allow create: if request.auth != null && request.auth.uid + '-church' == churchId;
      allow update, delete: if false;
    }

    // ── Config/main — members read; admins+managers write; self-creator may
    //    create during signup (S-7: allows the createChurch writeBatch to
    //    commit atomically before users/{uid} exists to satisfy
    //    isChurchAdminOrManager — rules in a batch are evaluated against
    //    pre-batch state). Matches the existing self-creator pattern on
    //    config/subscription above. ────────────────────────────────────────
    match /churches/{churchId}/config/main {
      allow read:           if isMember(churchId);
      allow create:         if request.auth != null && (
                                request.auth.uid + '-church' == churchId
                                || isChurchAdminOrManager(churchId)
                              );
      allow update, delete: if isChurchAdminOrManager(churchId);
    }

    // ── Config/settings — same pattern as config/main ───────────────────────
    match /churches/{churchId}/config/settings {
      allow read:           if isMember(churchId);
      allow create:         if request.auth != null && (
                                request.auth.uid + '-church' == churchId
                                || isChurchAdminOrManager(churchId)
                              );
      allow update, delete: if isChurchAdminOrManager(churchId);
    }

    // ── Notifications — members read; admin-only write ───────────────────────
    match /churches/{churchId}/config/notifications {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdmin(churchId);
    }

    // ── Items — members read + update (checkout/return); admins+mgrs create/delete ──
    match /churches/{churchId}/items/{docId} {
      allow read:          if isMember(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId);
      allow update:        if isMember(churchId);
    }

    // ── Supplies — members read + update (usage/restock); admins+mgrs create/delete ──
    match /churches/{churchId}/supplies/{docId} {
      allow read:           if isMember(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId);
      allow update:         if isMember(churchId);
    }

    // ── Activity log — immutable audit trail; members create, nobody modifies ──
    match /churches/{churchId}/activityLog/{docId} {
      allow read:          if isMember(churchId);
      allow create:        if isMember(churchId);
      allow update, delete: if false;
    }

    // ── Reservations — members create+update; admins+mgrs delete ─────────────
    match /churches/{churchId}/reservations/{docId} {
      allow read:   if isMember(churchId);
      allow create: if isMember(churchId);
      allow update: if isMember(churchId);
      allow delete: if isChurchAdminOrManager(churchId);
    }

    // ── Maintenance tickets ───────────────────────────────────────────────────
    match /churches/{churchId}/maintenanceTickets/{docId} {
      allow read:           if isMember(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId);
      allow update:         if isMember(churchId);
    }

    // ── Ticket comments — any member can add; authors can edit/delete own; admins+mgrs can edit/delete any ─────
    match /churches/{churchId}/maintenanceTickets/{ticketId}/comments/{commentId} {
      allow read:          if isMember(churchId);
      allow create:        if isMember(churchId);
      allow update, delete: if isChurchAdminOrManager(churchId) || (isMember(churchId) && request.auth.uid == resource.data.authorId);
    }

    // ── Tasks ─────────────────────────────────────────────────────────────────
    // Private tasks are only readable by their creator.
    // Shared/team tasks are readable by all members (shared-with enforcement is client-side,
    // as Firestore rules cannot iterate object arrays to check nested uid fields — 'shared'
    // tasks are treated as team-readable at the rule layer; the client filters by sharedWith).
    match /churches/{churchId}/tasks/{docId} {
      allow read: if isMember(churchId) && (
        !resource.data.keys().hasAny(['visibility']) ||
        resource.data.visibility == 'team' ||
        resource.data.visibility == 'shared' ||
        resource.data.createdBy == request.auth.uid
      );
      // create: enforce createdBy to prevent impersonation
      allow create: if isMember(churchId) && request.resource.data.createdBy == request.auth.uid;
      // update: members can update team/shared tasks; private tasks only by their creator.
      // Non-creators cannot escalate visibility to 'private'.
      // createdBy, taskNumber, and createdAt are immutable.
      // Known limitation: members can update team/shared tasks they didn't create (no
      // assignee-array check possible in rules — same pattern as Jobs Hub signups).
      allow update: if isMember(churchId) && (
        (resource.data.visibility != 'private' && request.resource.data.visibility != 'private')
        || resource.data.createdBy == request.auth.uid
      ) && (
        request.resource.data.visibility == resource.data.visibility
        || resource.data.createdBy == request.auth.uid
        || isChurchAdminOrManager(churchId)
      ) && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.taskNumber == resource.data.taskNumber
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isChurchAdminOrManager(churchId) || (isMember(churchId) && resource.data.createdBy == request.auth.uid);
    }

    // ── Task templates — members read; admins+mgrs create/delete ─────────────
    match /churches/{churchId}/taskTemplates/{docId} {
      allow read:           if isMember(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId);
      allow update:         if isChurchAdminOrManager(churchId);
    }

    // ── Task comments — any member can add; authors can edit/delete own; admins+mgrs can edit/delete any ─────
    // NOTE: comment reads are scoped to church members only; they are not further restricted
    // by parent task visibility (Firestore cannot do parent doc lookups in subcollection rules
    // without an extra get(), which would exceed the single-get() budget used by this ruleset).
    match /churches/{churchId}/tasks/{taskId}/comments/{commentId} {
      allow read:           if isMember(churchId);
      allow create:         if isMember(churchId);
      allow update, delete: if isChurchAdminOrManager(churchId) || (isMember(churchId) && request.auth.uid == resource.data.authorId);
    }

    // ── Job Hub — jobs: public read (job board is public info); members sign up;
    //    admins+mgrs create/delete/update fields.
    //    Member-branch rule constraints:
    //      • signups length must change by exactly ±1 (blocks mass-fill DoS and array rewrites)
    //      • new signups.size() must not exceed spotsTotal (enforces capacity server-side)
    //    Limitation: Firestore rules cannot iterate object arrays, so we cannot verify
    //    that the added/removed entry belongs to request.auth.uid — the client-side
    //    runTransaction in signUpForJob/withdrawFromJob enforces self-only semantics for
    //    honest callers; the ±1 delta constraint closes the practical attack surface. ──
    match /churches/{churchId}/jobListings/{docId} {
      allow get:            if isMember(churchId);
      // Public job-board reads are routed through the `getPublicJobs` callable
      // (functions/index.js) so signups[]/waitlist[] are stripped before the
      // response. Direct unauthenticated list/get is blocked here to prevent
      // raw-SDK PII pulls (Jobs Hub audit, 2026-05-06).
      allow list:           if isMember(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId);
      // Update has multiple paths:
      //   1a. Admin/manager general edit — broad write access, BUT cannot touch
      //       signups[]/waitlist[] in the same write as other fields, and cannot
      //       touch server-managed counters at all. F-16 from the 2026-05-12 audit.
      //   1b. Admin attendance update — signups changes only (length unchanged,
      //       entries mutated in place by updateJobSignupAttendance).
      //   1c. Admin removal — signups OR waitlist length -1 (handleAdminRemoveSignup
      //       reuses the member withdraw transaction; needs to work even when
      //       status is not open, e.g., cleaning up a closed job's roster).
      //   2.  Member — sign up / withdraw / join-or-leave-waitlist with strict
      //       ±1 length-delta + capacity guards. Field-presence guards on
      //       signups/waitlist/spotsTotal so legacy docs missing them don't
      //       crash the rule (defense-in-depth; backfill recommended).
      allow update:         if (
        isChurchAdminOrManager(churchId) && (
          // 1a. General edit — not touching arrays/server fields at all
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'signups', 'waitlist',
            'createdBy', 'createdByName', 'createdAt', 'jobNumber',
            'recurrenceGroupId', 'recurrenceFreq', 'seriesEndDate',
            'cancellationEmailSentAt', 'lastReminderSentDate', 'lastPosterNotifiedByActors'
          ])
          ||
          // 1b. Attendance update — signups only, length preserved
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signups', 'updatedAt']) &&
           'signups' in resource.data &&
           request.resource.data.signups.size() == resource.data.signups.size())
          ||
          // 1c. Admin remove signup — signups only, length -1
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signups', 'updatedAt']) &&
           'signups' in resource.data &&
           request.resource.data.signups.size() == resource.data.signups.size() - 1)
          ||
          // 1c. Admin remove waitlist entry — waitlist only, length -1
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waitlist', 'updatedAt']) &&
           'waitlist' in resource.data &&
           request.resource.data.waitlist.size() == resource.data.waitlist.size() - 1)
        )
      ) || (
        isMember(churchId) &&
        resource.data.status == 'open' &&
        'signups' in resource.data &&
        'waitlist' in resource.data &&
        'spotsTotal' in resource.data &&
        (
          // Sign up / withdraw
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signups', 'updatedAt']) &&
           (request.resource.data.signups.size() == resource.data.signups.size() + 1 ||
            request.resource.data.signups.size() == resource.data.signups.size() - 1) &&
           request.resource.data.signups.size() <= resource.data.spotsTotal)
          ||
          // Join / leave waitlist (±1 size enforced here and in client transaction).
          // Hard-cap at 50 to keep the doc under the 1MB Firestore limit and
          // close a denial-of-service vector (Jobs Hub audit, 2026-05-06 #10).
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waitlist', 'updatedAt']) &&
           (request.resource.data.waitlist.size() == resource.data.waitlist.size() + 1 ||
            request.resource.data.waitlist.size() == resource.data.waitlist.size() - 1) &&
           request.resource.data.waitlist.size() <= 50)
        )
      );
    }

    // ── Job Hub — swap requests: members create own; admins+mgrs read+delete; member can delete own ──
    match /churches/{churchId}/jobSwapRequests/{docId} {
      allow read:   if isChurchAdminOrManager(churchId);
      allow create: if isMember(churchId) && request.resource.data.uid == request.auth.uid;
      allow delete: if isChurchAdminOrManager(churchId) || (isMember(churchId) && resource.data.uid == request.auth.uid);
    }

    // ── Job Hub — announcements: members read; admins+mgrs write ─────────────
    match /churches/{churchId}/jobAnnouncements/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Rooms/Spaces — members read; admins+mgrs write ────────────────────────
    match /churches/{churchId}/rooms/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Vendors ───────────────────────────────────────────────────────────────
    match /churches/{churchId}/vendors/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Bundles ───────────────────────────────────────────────────────────────
    match /churches/{churchId}/bundles/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Audits ────────────────────────────────────────────────────────────────
    match /churches/{churchId}/audits/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Access People ─────────────────────────────────────────────────────────
    match /churches/{churchId}/accessPeople/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Access Records ────────────────────────────────────────────────────────
    match /churches/{churchId}/accessRecords/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Public requests — anyone can submit; only church members can read/dismiss ──
    match /churches/{churchId}/publicRequests/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && userChurchId() == churchId;
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        userChurchId() == resource.data.churchId
      );

      // New users can create their own profile.
      // Church creators may set role 'admin' only for their own church.
      // All other new registrations must set role 'user' (prevents self-escalation at signup).
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (
          request.resource.data.role == 'user'
          || (
            request.resource.data.role == 'admin'
            && request.resource.data.churchId == request.auth.uid + '-church'
          )
        );

      // Self-updates are allowed but cannot change role, churchId, active, or allowedHubs.
      // Admins in the same church can update role, active, allowedHubs, etc. — but cannot
      // change another user's phone or smsRemindersEnabled (TCPA: SMS opt-in must be the user's).
      // C-01: admins also CANNOT change churchId. Without this pin an admin could transplant
      // any user (or themselves) into another church, defeating multi-tenant isolation.
      allow update: if request.auth != null && (
        (
          request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.churchId == resource.data.churchId
          && request.resource.data.active == resource.data.active
          && request.resource.data.get('allowedHubs', null) == resource.data.get('allowedHubs', null)
        )
        || (
          userIsAdmin()
          && userChurchId() == resource.data.churchId
          && request.resource.data.churchId == resource.data.churchId
          && request.resource.data.get('phone', '') == resource.data.get('phone', '')
          && request.resource.data.get('smsRemindersEnabled', false) == resource.data.get('smsRemindersEnabled', false)
        )
      );

      // Self-delete or admin in same church
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        (userIsAdmin() && userChurchId() == resource.data.churchId)
      );
    }

    // ── Suggestions — any authenticated user can submit; owner-only read ──────
    // NOTE: owner emails also defined in functions/index.js (OWNER_EMAILS) and SettingsPage.jsx (isOwner). Keep in sync.
    match /suggestions/{docId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
    }

    // ── SMS opt-out audit log — Admin SDK writes only; owner-only read ────────
    // Populated by twilioInbound CF when users reply STOP/START. Retained
    // indefinitely per Privacy Policy commitment to honor opt-out requests.
    match /smsOptOuts/{docId} {
      allow read: if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
      allow create, update, delete: if false;
    }

    // ── Email suppression list (F-38) — Admin SDK writes only; owner-only read
    // Populated by sendgridEventWebhook when SendGrid reports bounce, dropped,
    // spamreport, or unsubscribe events. Read by sendEmailSafe before every
    // outbound message. Manually set `active: false` to un-suppress an address.
    match /emailSuppressions/{docId} {
      allow read: if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
      allow create, update, delete: if false;
    }

    // ── Email event audit log (F-38) — every SendGrid event lands here.
    match /emailEvents/{docId} {
      allow read: if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
      allow create, update, delete: if false;
    }

  }
}
