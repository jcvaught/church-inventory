rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Church data — accessible to authenticated users
    // Phase 1: any authenticated user can read/write
    // Phase 2: restrict to users belonging to the church
    match /churches/{churchId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // User profiles — users can read all, write their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
