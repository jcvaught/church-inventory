rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    // Single get() per request; all helpers derive from it.
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function userChurchId()         { return userData().churchId; }
    function userIsAdmin()          { return userData().role == 'admin'; }
    function userIsAdminOrManager() { return userData().role == 'admin' || userData().role == 'manager'; }
    // D-1 / COH-002: an explicit active:false revokes Firestore membership.
    // Missing defaults to true for legacy/hand-created profiles; every normal
    // creation path has written active:true since user profiles were introduced.
    function isMember(churchId)     { return request.auth != null && userData().get('active', true) == true && userChurchId() == churchId; }
    function isChurchAdmin(churchId)          { return isMember(churchId) && userIsAdmin(); }
    function isChurchAdminOrManager(churchId) { return isMember(churchId) && userIsAdminOrManager(); }

    // ── COH-006 work-item visibility ─────────────────────────────────────────
    // The single definition of who may see a work item, used by the read rule,
    // by update's PRE-STATE authorization check, and by comment gating. One
    // predicate rather than three, because three would drift.
    //
    // The uid arrays are canonical for authorization (DEC-2026-012), and both
    // are required to be lists: rules `in` also tests MAP KEYS, so without the
    // type check a malformed `{uid: true}` would grant access that no
    // array-contains query could ever deliver.
    //
    // `sharedWithUids` grants only while visibility is 'shared'. A private task
    // can carry a stale recipient — switching visibility does not always clear
    // the array, and the backfill projected whatever it found — and that
    // recipient must not be able to read it.
    //
    // There is deliberately NO admin override: private means private, including
    // from church admins. That has always been the promise and is now enforced.
    // Two shapes here are load-bearing and were both arrived at by measurement.
    //
    // Every field access is defaulted. A rules expression that touches a missing
    // field raises an evaluation error, and inside a LIST that error fails the
    // whole query for every caller — so one malformed document with no `type`
    // would take the task board down for the entire church rather than merely
    // hiding itself. Defaulting fails that document closed and leaves the rest
    // readable.
    //
    // Membership uses `.hasAny([uid])`, NOT `uid in field` guarded by `is list`.
    // The guarded form is denied for `array-contains` queries — measured: with
    // `is list` the assigned and shared list queries the deployed client runs are
    // rejected outright, without it they are admitted. `hasAny` keeps the
    // protection the guard existed for: rules `in` also tests MAP KEYS, so a
    // malformed `{uid: true}` would otherwise grant access no array-contains
    // query could ever deliver, whereas `hasAny` on a map raises an evaluation
    // error and fails closed. List-ness is additionally enforced where it is
    // cheap and total — the create and update rules both require both
    // projections to be lists, so no client can write the malformed shape.
    function canSeeWorkItem(d) {
      return d.get('type', '') == 'maintenance'
        || d.get('visibility', '') == 'team'
        || d.get('createdBy', '') == request.auth.uid
        || d.get('assigneeUids', []).hasAny([request.auth.uid])
        || (d.get('visibility', '') == 'shared'
            && d.get('sharedWithUids', []).hasAny([request.auth.uid]));
    }
    // Comments live under a fixed itemId, so the parent resolves deterministically
    // for both a single get and a subcollection list. A missing parent fails
    // closed rather than erroring.
    function canSeeWorkItemById(churchId, itemId) {
      return exists(/databases/$(database)/documents/churches/$(churchId)/workItems/$(itemId))
        && canSeeWorkItem(get(/databases/$(database)/documents/churches/$(churchId)/workItems/$(itemId)).data);
    }

    // ── COH-007 archive lifecycle — TRANSITIONAL ruleset (additive gate) ──────
    //
    // This ships BEFORE the backfill, so most tasks in production carry neither
    // `archived` nor `archivedAt`. Every predicate below therefore defaults a
    // MISSING field to "active": an unbackfilled task and its comments stay
    // fully usable. Written the obvious way instead — direct field access, or
    // `archived == false` — this rule would deny every ordinary edit and comment
    // write on every legacy task the moment it deployed, freezing the whole
    // board mid-rollout (plan A13, review finding H4).
    //
    // That tolerance is deliberately temporary. The FINAL ruleset, deployed with
    // the reader cutover, requires both fields on every task update; the
    // unbackfilled-task sentinel failing under it is the cutover signal, never an
    // acceptable production state. Leaving this permissive default in place
    // afterwards is the opposite failure — a client could delete the pair and
    // vanish from both equality-filtered readers.
    // Exactly THREE recognised shapes, and everything else is malformed
    // (review H1). The first implementation asked only `archived == true` and
    // treated every other value as active, which held for content updates —
    // those must also satisfy the shape below — but not for comments or DELETE,
    // which consulted the discriminator alone. A document carrying
    // `archived: 'true'`, `archived: 1`, or `archived: false` beside a non-null
    // `archivedAt` therefore stayed commentable and permanently deletable. That
    // is not the fail-closed behaviour a malformed archive state needs, and
    // delete is the one that cannot be undone.
    //
    // A malformed or half-written pair now permits nothing at all. It can only
    // be repaired by the Admin SDK, which these rules do not bind.
    function archiveFieldsAbsent(d) {
      return !('archived' in d) && !('archivedAt' in d);
    }
    function archiveFieldsActive(d) {
      return 'archived' in d && 'archivedAt' in d
        && d.archived is bool && d.archived == false
        && d.archivedAt == null;
    }
    function archiveFieldsFrozen(d) {
      return 'archived' in d && d.archived is bool && d.archived == true;
    }
    // The two shapes that permit ordinary work: a legacy task carrying neither
    // field (the whole population until the backfill runs), and a shaped active
    // one carrying both. Nothing in between.
    function archiveStateUsable(d) {
      return archiveFieldsAbsent(d) || archiveFieldsActive(d);
    }

    // The ONE archived -> active transition, as an exact field allowlist (plan
    // A14, review finding M1). Constraining the resulting VALUES is not enough:
    // the COH-006 update rule otherwise lets an authorized actor rewrite nearly
    // every task field, so a client could atomically reopen and rename a task,
    // alter its recipients, or delete `nextRecurrenceCreatedAt` — and that last
    // one defeats the recurrence dedupe marker, minting a second successor when
    // the reopened task is completed. `hasOnly` is what makes those unreachable.
    function isReopenTransition(pre, post) {
      return archiveFieldsActive(post)
        && post.get('status', '') == 'Backlog'
        && post.get('completedAt', 'x') == null
        && post.diff(pre).affectedKeys()
             .hasOnly(['archived', 'archivedAt', 'status', 'completedAt', 'updatedAt']);
    }

    // Every client task update, as one transition table:
    //
    //   frozen  -> exactly the reopen write, and nothing else
    //   active  -> must STAY active. Deleting the pair is denied as firmly as
    //              forging it: a task with neither field matches neither
    //              equality-filtered reader once the cutover lands, so a client
    //              able to drop them could make a task vanish from both.
    //   legacy  -> may stay legacy (the ordinary unbackfilled edit) or become
    //              active. It may never become archived.
    //   malformed -> nothing.
    function archiveTransitionAllowed(pre, post) {
      return archiveFieldsFrozen(pre)
        ? isReopenTransition(pre, post)
        : (archiveFieldsActive(pre)
            ? archiveFieldsActive(post)
            : (archiveFieldsAbsent(pre)
               && (archiveFieldsAbsent(post) || archiveFieldsActive(post))));
    }

    // Comment writes follow the parent's archive state. Short-circuits behind
    // canSeeWorkItemById at every call site, so the get() is both cached and
    // known to exist.
    function workItemArchiveUsable(churchId, itemId) {
      return archiveStateUsable(get(/databases/$(database)/documents/churches/$(churchId)/workItems/$(itemId)).data);
    }

    // Shepherd Hub (P2): elder status is a server-set custom auth claim
    // (`elder: true`), granted by claimElderRole against the email allow-list —
    // NOT a Firestore-doc role (those are raceable/readable). Baked into the
    // signed token; this reads it directly with no get().
    function isElder() { return request.auth != null && request.auth.token.elder == true; }
    // Shepherd Hub admin access is restricted to John specifically (NOT any
    // church admin) — pastoral data is need-to-know. Mirrors OWNER_EMAILS in
    // functions/index.js. Elders get in via isElder(); this is the only
    // non-elder who can read the hub.
    // SEC-2 (2026-06-11): require a verified email so an unverified squat on one
    // of these addresses can never satisfy the admin gate.
    function isShepherdAdmin() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org']; }

    // ── Jobs Hub access (audit H3 + M1, 2026-05-22) ──────────────────────────
    // jobsHubActive: the church's Jobs Hub subscription is active. Mirrors the
    //   server-side subHasHub() minus the trial-expiry time check (rules cannot
    //   compare a stored ISO date string to now — processTrialExpirations writes
    //   freeHubsSelected on expiry so the post-trial state is reflected here).
    // userHasJobsHub: this user is permitted the Jobs Hub (admins always are;
    //   a missing allowedHubs array means legacy-full-access).
    function jobsHubActive(churchId) {
      let s = get(/databases/$(database)/documents/churches/$(churchId)/config/subscription).data;
      return s != null && (
        s.grandfathered == true
        || s.plan == 'all_in'
        || (s.freeHubsSelected is list && s.freeHubsSelected.hasAny(['jobs']))
        || (s.freeHubsSelected == null && s.trialHubs is list && s.trialHubs.hasAny(['jobs']))
        || (s.hubs is list && s.hubs.hasAny(['jobs']))
      );
    }
    function userHasJobsHub() {
      return userIsAdmin()
        || !('allowedHubs' in userData())
        || (userData().allowedHubs is list && userData().allowedHubs.hasAny(['jobs']));
    }
    function canUseJobsHub(churchId) {
      return isMember(churchId) && jobsHubActive(churchId) && userHasJobsHub();
    }

    // ── Jobs Hub roster visibility (audit H1 follow-up, 2026-05-22) ───────────
    // The church-configurable jobsRosterVisibility setting ('admin' | 'signups'
    // | 'all', default 'signups') decides whether regular members may read a
    // job's signups/waitlist roster. Previously a UI-only gate; now a real
    // rule-enforced boundary on the protected subcollections.
    function jobsRosterVisibility(churchId) {
      let path = /databases/$(database)/documents/churches/$(churchId)/config/settings;
      return exists(path) ? get(path).data.get('jobsRosterVisibility', 'signups') : 'signups';
    }
    // A member is signed up to this job iff their own signups/{uid} doc exists.
    function isSignedUpToJob(churchId, jobId) {
      return exists(/databases/$(database)/documents/churches/$(churchId)/jobListings/$(jobId)/signups/$(request.auth.uid));
    }
    // Admin/manager always; members per the visibility setting.
    function canSeeJobRoster(churchId, jobId) {
      let vis = jobsRosterVisibility(churchId);
      return isChurchAdminOrManager(churchId)
        || (isMember(churchId) && vis == 'all')
        || (isMember(churchId) && vis == 'signups' && isSignedUpToJob(churchId, jobId));
    }

    // ── Church parent doc ─────────────────────────────────────────────────────
    // H-02 / Phase D from the 2026-05-12 audit: `allow list` removed. The
    // join-by-church-code lookup that previously needed list permission is now
    // routed through the `lookupChurchByCode` callable (functions/index.js) so
    // the server returns only the matched churchId and no other data. The
    // self-creator-check at registration uses a direct getDoc on
    // churches/{creator-uid}-church which is permitted by the `allow get`
    // self-creator branch below.
    match /churches/{churchId} {
      allow get:    if request.auth != null && (
                      request.auth.uid + '-church' == churchId ||
                      userChurchId() == churchId
                    );
      allow create: if request.auth != null && request.auth.uid + '-church' == churchId;
      allow update, delete: if isChurchAdmin(churchId);
    }

    // ── Subscription — client create allowed only for church creator (initial setup);
    //    all subsequent writes are done by webhooks via Admin SDK (bypasses rules). ──
    match /churches/{churchId}/config/subscription {
      allow read:   if isMember(churchId);
      allow create: if request.auth != null && request.auth.uid + '-church' == churchId;
      allow update, delete: if false;
    }

    // ── Config/main — members read; admins+managers write; self-creator may
    //    create during signup (S-7: allows the createChurch writeBatch to
    //    commit atomically before users/{uid} exists to satisfy
    //    isChurchAdminOrManager — rules in a batch are evaluated against
    //    pre-batch state). Matches the existing self-creator pattern on
    //    config/subscription above. ────────────────────────────────────────
    match /churches/{churchId}/config/main {
      allow read:           if isMember(churchId);
      allow create:         if request.auth != null && (
                                request.auth.uid + '-church' == churchId
                                || isChurchAdminOrManager(churchId)
                              );
      allow update, delete: if isChurchAdminOrManager(churchId);
    }

    // ── Config/settings — same pattern as config/main ───────────────────────
    match /churches/{churchId}/config/settings {
      allow read:           if isMember(churchId);
      allow create:         if request.auth != null && (
                                request.auth.uid + '-church' == churchId
                                || isChurchAdminOrManager(churchId)
                              );
      allow update, delete: if isChurchAdminOrManager(churchId);
    }

    // ── Notifications — members read; admin-only write ───────────────────────
    match /churches/{churchId}/config/notifications {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdmin(churchId);
    }

    // ── Feature flags — members read; admins+managers write (Work-unification
    //    Phase 2). Holds `workItemsEnabled`, the per-church read-path switch
    //    between the legacy tasks/maintenanceTickets collections and the unified
    //    workItems collection. Members must read it so useFirestore can pick the
    //    right subscription; flipping it is an admin/manager action (instant
    //    revert during a maintenance window). ─────────────────────────────────
    match /churches/{churchId}/config/featureFlags {
      allow read:           if isMember(churchId);
      allow create, update, delete: if isChurchAdminOrManager(churchId);
    }

    // ── Config/shepherdSync — Shepherd Hub sync status (last run, counts,
    //    per-elder load). Read = elder or admin; CF-only write (Admin SDK). ────
    match /churches/{churchId}/config/shepherdSync {
      allow read:  if isElder() || isShepherdAdmin();
      allow write: if false;
    }

    // ── Config/shepherdRoster — editable elder roster (names, sign-in emails,
    //    PCO match surnames, active/sabbatical). Drives the claim grant + the
    //    sync's name-matching. Read = elder or admin; write = admin only (the
    //    roster-management UI). ────────────────────────────────────────────────
    match /churches/{churchId}/config/shepherdRoster {
      allow read:  if isElder() || isShepherdAdmin();
      allow write: if isShepherdAdmin();
    }

    // ── Items — members read + update (checkout/return); admins+mgrs create/delete ──
    match /churches/{churchId}/items/{docId} {
      allow read:          if isMember(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId);
      allow update:        if isMember(churchId);
    }

    // ── Supplies — members read + update (usage/restock); admins+mgrs create/delete ──
    match /churches/{churchId}/supplies/{docId} {
      allow read:           if isMember(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId);
      allow update:         if isMember(churchId);
    }

    // ── Activity log — immutable, authenticated audit trail ─────────────────
    match /churches/{churchId}/activityLog/{docId} {
      allow read:          if isMember(churchId);
      // COH-002: mirror shepherdAudit's actor pin and require a server timestamp
      // (`serverTimestamp()` resolves to request.time during rule evaluation).
      allow create:        if isMember(churchId)
                           && request.resource.data.performedBy == request.auth.uid
                           && request.resource.data.performedByName == userData().get('name', '')
                           && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // ── Reservations — members create+update; admins+mgrs delete ─────────────
    match /churches/{churchId}/reservations/{docId} {
      allow read:   if isMember(churchId);
      allow create: if isMember(churchId);
      allow update: if isMember(churchId);
      allow delete: if isChurchAdminOrManager(churchId);
    }

    // ── Task templates — members read; admins+mgrs create/delete ─────────────
    match /churches/{churchId}/taskTemplates/{docId} {
      allow read:           if isMember(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId);
      allow update:         if isChurchAdminOrManager(churchId);
    }

    // ── Work items — unified Tasks + Maintenance (Work Unification Phase 2) ────
    //    Canonical collection after the completed cutover; COH-002 removed the
    //    obsolete tasks/maintenanceTickets rule paths. A workItems doc carries
    //    `type: 'task' | 'maintenance'`, so the gates below switch on that field:
    //      task        → the visibility/immutability rules from the tasks block
    //      maintenance → admin/manager create+delete, any-member update (no field guards)
    match /churches/{churchId}/workItems/{docId} {
      // COH-006 GATE 4 — the restrictive rules. This is the boundary the whole
      // task exists to create. Until now `visibility == 'shared'` admitted any
      // member, so 80 of 90 tasks in the live church were readable by everyone;
      // the transitional assignee arm and the legacy missing-visibility arm are
      // both gone, the latter only because production verification showed every
      // task carries a value.
      allow read: if isMember(churchId) && canSeeWorkItem(resource.data);

      // create: maintenance is admin/manager-only; tasks are any member, enforcing
      // createdBy and the projection shape (DEC-2026-013, shipped in gate 1).
      allow create: if isMember(churchId) && (
        (request.resource.data.type == 'maintenance' && isChurchAdminOrManager(churchId))
        || (request.resource.data.type == 'task'
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.visibility in ['team', 'private', 'shared']
            && request.resource.data.assigneeUids is list
            && request.resource.data.sharedWithUids is list
            // COH-007: a task is born active, carrying BOTH fields or
            // NEITHER. Absence is tolerated on purpose — a browser tab still
            // running the pre-COH-007 bundle must keep being able to create a
            // task through the additive gate — but a half-written pair is not,
            // because a document created that way would be locked on arrival
            // by the malformed-state rule below. The FINAL ruleset requires
            // the pair outright.
            && archiveStateUsable(request.resource.data))
      );

      // update: authorization is decided from resource.data — the PRE-state —
      // never from the document being proposed. That is what stops a self-grant:
      // a member who cannot already see the task cannot write their own uid into
      // a projection to gain it, because the check runs against the document as
      // it stands. Role is not preauthorization either; an admin who cannot see
      // the task cannot update it.
      //
      // Per DEC-2026-012 the projections are deliberately NOT pinned to their
      // `assignees`/`sharedWith` object arrays: anyone already authorized may
      // widen access, and the uid arrays are canonical. Divergence between the
      // two is a client bug, not a rules violation.
      allow update: if isMember(churchId)
        && request.resource.data.type == resource.data.type
        && (
          resource.data.type == 'maintenance'
          || (
            canSeeWorkItem(resource.data)
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.taskNumber == resource.data.taskNumber
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.visibility in ['team', 'private', 'shared']
            && request.resource.data.assigneeUids is list
            && request.resource.data.sharedWithUids is list
            // Changing visibility stays creator/admin-only, as before — and an
            // admin reaches this only after passing canSeeWorkItem above, so the
            // role can never bypass the parent boundary.
            && (request.resource.data.visibility == resource.data.visibility
                || resource.data.createdBy == request.auth.uid
                || isChurchAdminOrManager(churchId))
            // COH-007: archived is frozen except for the one reopen transition;
            // active may not forge its way into the archive; malformed permits
            // nothing. Sits AFTER the COH-006 pre-state authorization above, so
            // reopen inherits it rather than replacing it.
            && archiveTransitionAllowed(resource.data, request.resource.data)
          )
        );
      // delete: maintenance admin/manager-only; tasks admin/manager or the creator.
      // COH-007: an archived task must be reopened before the existing
      // permanent-delete flow is available to anyone, creator and admin alike —
      // and a task whose archive state is malformed cannot be deleted at all,
      // because we cannot tell whether it is archived (review H1).
      allow delete: if (resource.data.type == 'maintenance' && isChurchAdminOrManager(churchId))
        || (resource.data.type == 'task' && archiveStateUsable(resource.data) && (
          isChurchAdminOrManager(churchId)
          || (isMember(churchId) && resource.data.createdBy == request.auth.uid)
        ));
    }

    // ── Work item comments — same shape as task/ticket comments ──────────────
    // COH-006 gate 4: a comment is only as private as its parent. Previously any
    // member could read and write comments under every work item, so private task
    // DISCUSSION stayed exposed even once the task itself was gated. The parent
    // predicate is an additional condition on every operation, never an
    // alternative to the author/admin check — an admin who cannot see the task
    // cannot moderate its comments.
    //
    // Not fixed here, and recorded rather than implied: `authorId`, `authorName`
    // and the timestamps are still unpinned, so attribution remains spoofable by
    // an authorized member. Changing that is an attribution policy decision the
    // owner has not made.
    match /churches/{churchId}/workItems/{itemId}/comments/{commentId} {
      // COH-007: an archived task's discussion stays READABLE and becomes
      // read-only. There is no backlink carve-out in that freeze — DEC-2026-017
      // moved the only write that needed one (clearing a reciprocal link when a
      // ticket or job is deleted) onto the COH-008 server triggers, which run
      // under the Admin SDK and are not bound by these rules.
      allow read:           if isMember(churchId) && canSeeWorkItemById(churchId, itemId);
      allow create:         if isMember(churchId) && canSeeWorkItemById(churchId, itemId)
                            && workItemArchiveUsable(churchId, itemId);
      allow update, delete: if isMember(churchId) && canSeeWorkItemById(churchId, itemId)
                            && workItemArchiveUsable(churchId, itemId)
                            && (isChurchAdminOrManager(churchId) || request.auth.uid == resource.data.authorId);
    }

    // ── Job Hub — job listings (audit H1/H2/H3/M1, 2026-05-22) ───────────────
    //    The roster (signups/waitlist) lives in protected per-uid subcollections
    //    below — NOT on this parent doc. The parent carries only non-PII fields
    //    plus the server-maintained signupCount/waitlistCount integers. ALL
    //    roster writes go through Cloud Functions (jobSignUp / jobWithdraw /
    //    jobSetAttendance, Admin SDK) which enforce compliance/waiver/capacity
    //    server-side; members never write this doc directly. Public job-board
    //    reads are still served by the `getPublicJobs` callable.
    match /churches/{churchId}/jobListings/{docId} {
      allow get, list:      if canUseJobsHub(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId) && jobsHubActive(churchId);
      // Admin/manager general edit only — cannot touch identity, recurrence,
      // server-managed dedupe stamps, the (now-removed) roster arrays, or the
      // server-maintained counters.
      allow update:         if isChurchAdminOrManager(churchId)
        && jobsHubActive(churchId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'signups', 'waitlist', 'signupCount', 'waitlistCount',
             'createdBy', 'createdByName', 'createdAt', 'jobNumber',
             'recurrenceGroupId', 'recurrenceFreq', 'seriesEndDate',
             'cancellationEmailSentAt', 'lastReminderSentDate',
             'lastSmsReminderSentDate', 'lastPosterNotifiedByActors'
           ]);
    }

    // ── Job Hub — signups / waitlist subcollections (audit H1) ───────────────
    //    One doc per member, keyed by uid; volunteer names live here, never on
    //    the parent. Via a collectionGroup query a member reads only their OWN
    //    doc (the {path=**} rules). Via the church-scoped path rules, admin and
    //    manager always read the full roster, and regular members read it when
    //    the jobsRosterVisibility setting permits (canSeeJobRoster). Writes are
    //    Cloud Functions only (Admin SDK bypasses these rules).
    match /{path=**}/signups/{signupId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }
    match /{path=**}/waitlist/{waitlistId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }
    match /churches/{churchId}/jobListings/{jobId}/signups/{signupId} {
      allow read:  if canSeeJobRoster(churchId, jobId);
      allow write: if false;
    }
    match /churches/{churchId}/jobListings/{jobId}/waitlist/{waitlistId} {
      allow read:  if canSeeJobRoster(churchId, jobId);
      allow write: if false;
    }

    // ── Job Hub — swap requests: members create own; admins+mgrs read+delete; member can delete own ──
    //    Audit L4: the create is bounded — exact key allowlist, uid pinned to
    //    the caller, name pinned to the caller's own user-doc name (no
    //    impersonation in this admin-read field; userData() reuses the
    //    request's single get), and the free-text note capped at 1000 chars.
    match /churches/{churchId}/jobSwapRequests/{docId} {
      // Members can read their own pending requests so the UI can offer a
      // "Withdraw Request" affordance (UI audit Phase 5). Admins/managers
      // still see every request for triage.
      allow read:   if isChurchAdminOrManager(churchId)
                    || (isMember(churchId) && resource.data.uid == request.auth.uid);
      allow create: if canUseJobsHub(churchId)
        && request.resource.data.keys().hasOnly(['jobDocId', 'uid', 'name', 'note', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == userData().get('name', '')
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000;
      allow delete: if isChurchAdminOrManager(churchId) || (isMember(churchId) && resource.data.uid == request.auth.uid);
    }

    // ── Job Hub — announcements: members (with hub access) read; admins+mgrs write ──
    //    Identity + audit fields are immutable on edit (audit M7, mirrors the
    //    hardened jobListings update rule).
    match /churches/{churchId}/jobAnnouncements/{docId} {
      allow read:           if canUseJobsHub(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId) && jobsHubActive(churchId);
      allow update:         if isChurchAdminOrManager(churchId)
        && jobsHubActive(churchId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'createdBy', 'createdByName', 'createdAt'
           ]);
    }

    // ── Rooms/Spaces — members read; admins+mgrs write ────────────────────────
    match /churches/{churchId}/rooms/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Vendors ───────────────────────────────────────────────────────────────
    match /churches/{churchId}/vendors/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Bundles ───────────────────────────────────────────────────────────────
    match /churches/{churchId}/bundles/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Audits ────────────────────────────────────────────────────────────────
    match /churches/{churchId}/audits/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Access People ─────────────────────────────────────────────────────────
    // Managers/admins read the full hub. Ordinary members may read only tracked
    // person docs linked to their own uid for Settings → My Compliance.
    match /churches/{churchId}/accessPeople/{docId} {
      allow read:  if isChurchAdminOrManager(churchId)
                   || (isMember(churchId) && resource.data.userId == request.auth.uid);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Access Records ────────────────────────────────────────────────────────
    // Self reads follow the linked accessPeople parent; the client queries by
    // personId after resolving only its own userId-linked person docs.
    match /churches/{churchId}/accessRecords/{docId} {
      allow read:  if isChurchAdminOrManager(churchId)
                   || (isMember(churchId)
                       && get(/databases/$(database)/documents/churches/$(churchId)/accessPeople/$(resource.data.personId)).data.userId == request.auth.uid);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Shepherd Hub people cache ────────────────────────────────────────────
    //    Cloud-Function-written mirror of Planning Center people. Read = elders
    //    (custom claim) or church admin (P1 lock retained for support/debug —
    //    the Level-1 privacy model already accepts admin readability of this
    //    PCO-sourced data). NO client write (Admin SDK / sync CF only). Holds
    //    sensitive pastoral data incl. medical_notes.
    match /churches/{churchId}/shepherdPeople/{docId} {
      allow read:  if isElder() || isShepherdAdmin();
      allow write: if false;
    }

    // ── Private pastoral note — one per (person, elder); doc id = the elder's
    //    uid. Only the owning elder may read or write it — private even from
    //    other elders and from admins (Level 1: enforced by rules; Level 2
    //    client-side encryption is the fast-follow). ─────────────────────────
    match /churches/{churchId}/shepherdPeople/{personId}/privateNotes/{ownerUid} {
      allow read, write: if isElder() && request.auth.uid == ownerUid;
    }

    // ── Shared care thread — any elder reads/appends; entries are author-owned
    //    (only the authoring elder may edit/delete their own entry — no admin
    //    edit/delete path). Admins do not read by default (elders-only space). ──
    match /churches/{churchId}/shepherdPeople/{personId}/careThread/{entryId} {
      allow read:   if isElder();
      allow create: if isElder() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isElder() && resource.data.authorUid == request.auth.uid;
    }

    // ── Last-contact stamp (UX-2): a tiny per-person doc holding `lastCareAt`,
    //    written by an elder when they post/remove a care-thread entry. Kept in
    //    a SEPARATE top-level collection (not on the shepherdPeople doc) so the
    //    nightly full-overwrite sync never clobbers it. Non-sensitive (a
    //    timestamp), so any elder may write it. ─────────────────────────────────
    match /churches/{churchId}/shepherdCare/{personId} {
      allow read:  if isElder() || isShepherdAdmin();
      allow write: if isElder();
    }

    // ── Shepherd audit log — every note view/edit + reassignment. Append-only;
    //    every elder/admin WRITES, but only the admin READS (SEC-6, 2026-06-11):
    //    elder-readable rows leaked which people each elder kept private notes on
    //    (personId+personName+actor), metadata about a note promised "only you".
    //    Elders never needed to browse it — it's an accountability record. ──────
    match /churches/{churchId}/shepherdAudit/{entryId} {
      allow read:   if isShepherdAdmin();
      allow create: if (isElder() || isShepherdAdmin()) && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Time Entries (contractor / labor hours) — payroll-sensitive, so
    //    admin/manager only for both read and write. (Contractor self-logging
    //    is a deferred follow-up; it would relax create for a linked user.)
    match /churches/{churchId}/timeEntries/{docId} {
      allow read:  if isChurchAdminOrManager(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Public requests — anyone can submit; only church members can read/dismiss ──
    //    create is unauthenticated by design (public item-request form); audit L6
    //    bounds it with an exact key allowlist + length caps so it can't be used
    //    as an arbitrary-blob spam / Firestore-cost vector.
    match /churches/{churchId}/publicRequests/{docId} {
      allow create: if request.resource.data.keys().hasOnly([
                         'name', 'email', 'phone', 'itemDescription', 'quantity',
                         'dateNeeded', 'urgency', 'notes', 'status', 'submittedAt'
                       ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.itemDescription is string
        && request.resource.data.itemDescription.size() > 0
        && request.resource.data.itemDescription.size() <= 2000
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.status == 'pending';
      allow read, update, delete: if request.auth != null && userChurchId() == churchId;
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        userChurchId() == resource.data.churchId
      );

      // New users can create their own profile.
      // Church creators may set role 'admin' only for their own church.
      // All other new registrations must set role 'user' (prevents self-escalation at signup).
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (
          request.resource.data.role == 'user'
          || (
            request.resource.data.role == 'admin'
            && request.resource.data.churchId == request.auth.uid + '-church'
          )
        );

      // Self-updates are allowed but cannot change role, churchId, active, or allowedHubs.
      // Admins in the same church can update role, active, allowedHubs, etc. — but cannot
      // change another user's phone, smsRemindersEnabled, or smsNewJobsEnabled
      // (TCPA: every SMS opt-in must be the user's own).
      // C-01: admins also CANNOT change churchId. Without this pin an admin could transplant
      // any user (or themselves) into another church, defeating multi-tenant isolation.
      allow update: if request.auth != null && (
        (
          request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.churchId == resource.data.churchId
          && request.resource.data.active == resource.data.active
          && request.resource.data.get('allowedHubs', null) == resource.data.get('allowedHubs', null)
        )
        || (
          userIsAdmin()
          && userChurchId() == resource.data.churchId
          && request.resource.data.churchId == resource.data.churchId
          && request.resource.data.get('phone', '') == resource.data.get('phone', '')
          && request.resource.data.get('smsRemindersEnabled', false) == resource.data.get('smsRemindersEnabled', false)
          && request.resource.data.get('smsNewJobsEnabled', false) == resource.data.get('smsNewJobsEnabled', false)
        )
      );

      // Self-delete or admin in same church
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        (userIsAdmin() && userChurchId() == resource.data.churchId)
      );
    }

    // ── Suggestions — any authenticated user can submit; owner-only read ──────
    // NOTE: owner emails also defined in functions/index.js (OWNER_EMAILS) and SettingsPage.jsx (isOwner). Keep in sync.
    match /suggestions/{docId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
    }

    // ── SMS opt-out audit log — Admin SDK writes only; owner-only read ────────
    // Populated by twilioInbound CF when users reply STOP/START. Retained
    // indefinitely per Privacy Policy commitment to honor opt-out requests.
    match /smsOptOuts/{docId} {
      allow read: if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
      allow create, update, delete: if false;
    }

    // ── Email suppression list (F-38) — Admin SDK writes only; owner-only read
    // Populated by sendgridEventWebhook when SendGrid reports bounce, dropped,
    // spamreport, or unsubscribe events. Read by sendEmailSafe before every
    // outbound message. Manually set `active: false` to un-suppress an address.
    match /emailSuppressions/{docId} {
      allow read: if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
      allow create, update, delete: if false;
    }

    // ── Email event audit log (F-38) — every SendGrid event lands here.
    match /emailEvents/{docId} {
      allow read: if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
      allow create, update, delete: if false;
    }

    // ── Notifications (in-app inbox) — a member reads/updates/deletes only
    //    their OWN notifications. Create is Admin-SDK-only (the deliverNotification
    //    helper / notify callable) — clients never write these directly.
    match /churches/{churchId}/notifications/{docId} {
      allow read:   if isMember(churchId) && (resource == null || resource.data.recipientUid == request.auth.uid);
      allow update: if isMember(churchId) && resource.data.recipientUid == request.auth.uid
                    && request.resource.data.recipientUid == resource.data.recipientUid;
      allow delete: if isMember(churchId) && resource.data.recipientUid == request.auth.uid;
      allow create: if false;
    }

    // ── App-wide banner (maintenance / announcements) — any signed-in user
    //    reads; owner-only writes. Drives the GlobalBanner in the app shell and
    //    the "we're updating" notice during migration windows.
    //    NOTE: owner emails also in functions/index.js (OWNER_EMAILS) and
    //    SettingsPage.jsx (isOwner). Keep in sync.
    match /appConfig/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
    }

    // ── Errors (audit M5) — no client error-telemetry collection exists;
    //    Sentry (@sentry/react) handles all error reporting. This explicit
    //    deny makes the absence intentional: any future feature that needs an
    //    `errors` collection must add a considered rule rather than silently
    //    inherit access from a default. Do not relax without a real consumer.
    match /errors/{docId} {
      allow read, write: if false;
    }

  }
}
