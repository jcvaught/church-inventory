rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    // Single get() per request; all helpers derive from it.
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function userChurchId()         { return userData().churchId; }
    function userIsAdmin()          { return userData().role == 'admin'; }
    function userIsAdminOrManager() { return userData().role == 'admin' || userData().role == 'manager'; }
    function isMember(churchId)     { return request.auth != null && userChurchId() == churchId; }
    function isChurchAdmin(churchId)          { return isMember(churchId) && userIsAdmin(); }
    function isChurchAdminOrManager(churchId) { return isMember(churchId) && userIsAdminOrManager(); }

    // Shepherd Hub (P2): elder status is a server-set custom auth claim
    // (`elder: true`), granted by claimElderRole against the email allow-list —
    // NOT a Firestore-doc role (those are raceable/readable). Baked into the
    // signed token; this reads it directly with no get().
    function isElder() { return request.auth != null && request.auth.token.elder == true; }

    // ── Jobs Hub access (audit H3 + M1, 2026-05-22) ──────────────────────────
    // jobsHubActive: the church's Jobs Hub subscription is active. Mirrors the
    //   server-side subHasHub() minus the trial-expiry time check (rules cannot
    //   compare a stored ISO date string to now — processTrialExpirations writes
    //   freeHubsSelected on expiry so the post-trial state is reflected here).
    // userHasJobsHub: this user is permitted the Jobs Hub (admins always are;
    //   a missing allowedHubs array means legacy-full-access).
    function jobsHubActive(churchId) {
      let s = get(/databases/$(database)/documents/churches/$(churchId)/config/subscription).data;
      return s != null && (
        s.grandfathered == true
        || s.plan == 'all_in'
        || (s.freeHubsSelected is list && s.freeHubsSelected.hasAny(['jobs']))
        || (s.freeHubsSelected == null && s.trialHubs is list && s.trialHubs.hasAny(['jobs']))
        || (s.hubs is list && s.hubs.hasAny(['jobs']))
      );
    }
    function userHasJobsHub() {
      return userIsAdmin()
        || !('allowedHubs' in userData())
        || (userData().allowedHubs is list && userData().allowedHubs.hasAny(['jobs']));
    }
    function canUseJobsHub(churchId) {
      return isMember(churchId) && jobsHubActive(churchId) && userHasJobsHub();
    }

    // ── Jobs Hub roster visibility (audit H1 follow-up, 2026-05-22) ───────────
    // The church-configurable jobsRosterVisibility setting ('admin' | 'signups'
    // | 'all', default 'signups') decides whether regular members may read a
    // job's signups/waitlist roster. Previously a UI-only gate; now a real
    // rule-enforced boundary on the protected subcollections.
    function jobsRosterVisibility(churchId) {
      let path = /databases/$(database)/documents/churches/$(churchId)/config/settings;
      return exists(path) ? get(path).data.get('jobsRosterVisibility', 'signups') : 'signups';
    }
    // A member is signed up to this job iff their own signups/{uid} doc exists.
    function isSignedUpToJob(churchId, jobId) {
      return exists(/databases/$(database)/documents/churches/$(churchId)/jobListings/$(jobId)/signups/$(request.auth.uid));
    }
    // Admin/manager always; members per the visibility setting.
    function canSeeJobRoster(churchId, jobId) {
      let vis = jobsRosterVisibility(churchId);
      return isChurchAdminOrManager(churchId)
        || (isMember(churchId) && vis == 'all')
        || (isMember(churchId) && vis == 'signups' && isSignedUpToJob(churchId, jobId));
    }

    // ── Church parent doc ─────────────────────────────────────────────────────
    // H-02 / Phase D from the 2026-05-12 audit: `allow list` removed. The
    // join-by-church-code lookup that previously needed list permission is now
    // routed through the `lookupChurchByCode` callable (functions/index.js) so
    // the server returns only the matched churchId and no other data. The
    // self-creator-check at registration uses a direct getDoc on
    // churches/{creator-uid}-church which is permitted by the `allow get`
    // self-creator branch below.
    match /churches/{churchId} {
      allow get:    if request.auth != null && (
                      request.auth.uid + '-church' == churchId ||
                      userChurchId() == churchId
                    );
      allow create: if request.auth != null && request.auth.uid + '-church' == churchId;
      allow update, delete: if isChurchAdmin(churchId);
    }

    // ── Subscription — client create allowed only for church creator (initial setup);
    //    all subsequent writes are done by webhooks via Admin SDK (bypasses rules). ──
    match /churches/{churchId}/config/subscription {
      allow read:   if isMember(churchId);
      allow create: if request.auth != null && request.auth.uid + '-church' == churchId;
      allow update, delete: if false;
    }

    // ── Config/main — members read; admins+managers write; self-creator may
    //    create during signup (S-7: allows the createChurch writeBatch to
    //    commit atomically before users/{uid} exists to satisfy
    //    isChurchAdminOrManager — rules in a batch are evaluated against
    //    pre-batch state). Matches the existing self-creator pattern on
    //    config/subscription above. ────────────────────────────────────────
    match /churches/{churchId}/config/main {
      allow read:           if isMember(churchId);
      allow create:         if request.auth != null && (
                                request.auth.uid + '-church' == churchId
                                || isChurchAdminOrManager(churchId)
                              );
      allow update, delete: if isChurchAdminOrManager(churchId);
    }

    // ── Config/settings — same pattern as config/main ───────────────────────
    match /churches/{churchId}/config/settings {
      allow read:           if isMember(churchId);
      allow create:         if request.auth != null && (
                                request.auth.uid + '-church' == churchId
                                || isChurchAdminOrManager(churchId)
                              );
      allow update, delete: if isChurchAdminOrManager(churchId);
    }

    // ── Notifications — members read; admin-only write ───────────────────────
    match /churches/{churchId}/config/notifications {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdmin(churchId);
    }

    // ── Config/shepherdSync — Shepherd Hub sync status (last run, counts,
    //    per-elder load). Read = elder or admin; CF-only write (Admin SDK). ────
    match /churches/{churchId}/config/shepherdSync {
      allow read:  if isElder() || isChurchAdmin(churchId);
      allow write: if false;
    }

    // ── Config/shepherdRoster — editable elder roster (names, sign-in emails,
    //    PCO match surnames, active/sabbatical). Drives the claim grant + the
    //    sync's name-matching. Read = elder or admin; write = admin only (the
    //    roster-management UI). ────────────────────────────────────────────────
    match /churches/{churchId}/config/shepherdRoster {
      allow read:  if isElder() || isChurchAdmin(churchId);
      allow write: if isChurchAdmin(churchId);
    }

    // ── Items — members read + update (checkout/return); admins+mgrs create/delete ──
    match /churches/{churchId}/items/{docId} {
      allow read:          if isMember(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId);
      allow update:        if isMember(churchId);
    }

    // ── Supplies — members read + update (usage/restock); admins+mgrs create/delete ──
    match /churches/{churchId}/supplies/{docId} {
      allow read:           if isMember(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId);
      allow update:         if isMember(churchId);
    }

    // ── Activity log — immutable audit trail; members create, nobody modifies ──
    match /churches/{churchId}/activityLog/{docId} {
      allow read:          if isMember(churchId);
      allow create:        if isMember(churchId);
      allow update, delete: if false;
    }

    // ── Reservations — members create+update; admins+mgrs delete ─────────────
    match /churches/{churchId}/reservations/{docId} {
      allow read:   if isMember(churchId);
      allow create: if isMember(churchId);
      allow update: if isMember(churchId);
      allow delete: if isChurchAdminOrManager(churchId);
    }

    // ── Maintenance tickets ───────────────────────────────────────────────────
    match /churches/{churchId}/maintenanceTickets/{docId} {
      allow read:           if isMember(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId);
      allow update:         if isMember(churchId);
    }

    // ── Ticket comments — any member can add; authors can edit/delete own; admins+mgrs can edit/delete any ─────
    match /churches/{churchId}/maintenanceTickets/{ticketId}/comments/{commentId} {
      allow read:          if isMember(churchId);
      allow create:        if isMember(churchId);
      allow update, delete: if isChurchAdminOrManager(churchId) || (isMember(churchId) && request.auth.uid == resource.data.authorId);
    }

    // ── Tasks ─────────────────────────────────────────────────────────────────
    // Private tasks are only readable by their creator.
    // Shared/team tasks are readable by all members (shared-with enforcement is client-side,
    // as Firestore rules cannot iterate object arrays to check nested uid fields — 'shared'
    // tasks are treated as team-readable at the rule layer; the client filters by sharedWith).
    match /churches/{churchId}/tasks/{docId} {
      allow read: if isMember(churchId) && (
        !resource.data.keys().hasAny(['visibility']) ||
        resource.data.visibility == 'team' ||
        resource.data.visibility == 'shared' ||
        resource.data.createdBy == request.auth.uid
      );
      // create: enforce createdBy to prevent impersonation
      allow create: if isMember(churchId) && request.resource.data.createdBy == request.auth.uid;
      // update: members can update team/shared tasks; private tasks only by their creator.
      // Non-creators cannot escalate visibility to 'private'.
      // createdBy, taskNumber, and createdAt are immutable.
      // Known limitation: members can update team/shared tasks they didn't create (no
      // assignee-array check possible in rules — same pattern as Jobs Hub signups).
      allow update: if isMember(churchId) && (
        (resource.data.visibility != 'private' && request.resource.data.visibility != 'private')
        || resource.data.createdBy == request.auth.uid
      ) && (
        request.resource.data.visibility == resource.data.visibility
        || resource.data.createdBy == request.auth.uid
        || isChurchAdminOrManager(churchId)
      ) && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.taskNumber == resource.data.taskNumber
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isChurchAdminOrManager(churchId) || (isMember(churchId) && resource.data.createdBy == request.auth.uid);
    }

    // ── Task templates — members read; admins+mgrs create/delete ─────────────
    match /churches/{churchId}/taskTemplates/{docId} {
      allow read:           if isMember(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId);
      allow update:         if isChurchAdminOrManager(churchId);
    }

    // ── Task comments — any member can add; authors can edit/delete own; admins+mgrs can edit/delete any ─────
    // NOTE: comment reads are scoped to church members only; they are not further restricted
    // by parent task visibility (Firestore cannot do parent doc lookups in subcollection rules
    // without an extra get(), which would exceed the single-get() budget used by this ruleset).
    match /churches/{churchId}/tasks/{taskId}/comments/{commentId} {
      allow read:           if isMember(churchId);
      allow create:         if isMember(churchId);
      allow update, delete: if isChurchAdminOrManager(churchId) || (isMember(churchId) && request.auth.uid == resource.data.authorId);
    }

    // ── Work items — unified Tasks + Maintenance (Work Unification Phase 2) ────
    //    Additive: the `tasks` and `maintenanceTickets` blocks above stay live
    //    until the read path flips in a maintenance window. A workItems doc is a
    //    verbatim copy of its source plus `type: 'task' | 'maintenance'`, so the
    //    gates below reproduce the two source rule sets switched on that field:
    //      task        → the visibility/immutability rules from the tasks block
    //      maintenance → admin/manager create+delete, any-member update (no field guards)
    match /churches/{churchId}/workItems/{docId} {
      // read: maintenance is member-readable; tasks are visibility-gated (private = creator only).
      allow read: if isMember(churchId) && (
        resource.data.type == 'maintenance'
        || !resource.data.keys().hasAny(['visibility'])
        || resource.data.visibility == 'team'
        || resource.data.visibility == 'shared'
        || resource.data.createdBy == request.auth.uid
      );
      // create: maintenance is admin/manager-only; tasks are any member, enforcing createdBy.
      allow create: if isMember(churchId) && (
        (request.resource.data.type == 'maintenance' && isChurchAdminOrManager(churchId))
        || (request.resource.data.type == 'task' && request.resource.data.createdBy == request.auth.uid)
      );
      // update: maintenance is any member; tasks keep the visibility + immutability predicate.
      allow update: if isMember(churchId) && (
        resource.data.type == 'maintenance'
        || (
          (
            (resource.data.visibility != 'private' && request.resource.data.visibility != 'private')
            || resource.data.createdBy == request.auth.uid
          ) && (
            request.resource.data.visibility == resource.data.visibility
            || resource.data.createdBy == request.auth.uid
            || isChurchAdminOrManager(churchId)
          )
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.taskNumber == resource.data.taskNumber
          && request.resource.data.createdAt == resource.data.createdAt
        )
      );
      // delete: maintenance admin/manager-only; tasks admin/manager or the creator.
      allow delete: if (resource.data.type == 'maintenance' && isChurchAdminOrManager(churchId))
        || (resource.data.type == 'task' && (
          isChurchAdminOrManager(churchId)
          || (isMember(churchId) && resource.data.createdBy == request.auth.uid)
        ));
    }

    // ── Work item comments — same shape as task/ticket comments ──────────────
    match /churches/{churchId}/workItems/{itemId}/comments/{commentId} {
      allow read:           if isMember(churchId);
      allow create:         if isMember(churchId);
      allow update, delete: if isChurchAdminOrManager(churchId) || (isMember(churchId) && request.auth.uid == resource.data.authorId);
    }

    // ── Job Hub — job listings (audit H1/H2/H3/M1, 2026-05-22) ───────────────
    //    The roster (signups/waitlist) lives in protected per-uid subcollections
    //    below — NOT on this parent doc. The parent carries only non-PII fields
    //    plus the server-maintained signupCount/waitlistCount integers. ALL
    //    roster writes go through Cloud Functions (jobSignUp / jobWithdraw /
    //    jobSetAttendance, Admin SDK) which enforce compliance/waiver/capacity
    //    server-side; members never write this doc directly. Public job-board
    //    reads are still served by the `getPublicJobs` callable.
    match /churches/{churchId}/jobListings/{docId} {
      allow get, list:      if canUseJobsHub(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId) && jobsHubActive(churchId);
      // Admin/manager general edit only — cannot touch identity, recurrence,
      // server-managed dedupe stamps, the (now-removed) roster arrays, or the
      // server-maintained counters.
      allow update:         if isChurchAdminOrManager(churchId)
        && jobsHubActive(churchId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'signups', 'waitlist', 'signupCount', 'waitlistCount',
             'createdBy', 'createdByName', 'createdAt', 'jobNumber',
             'recurrenceGroupId', 'recurrenceFreq', 'seriesEndDate',
             'cancellationEmailSentAt', 'lastReminderSentDate',
             'lastSmsReminderSentDate', 'lastPosterNotifiedByActors'
           ]);
    }

    // ── Job Hub — signups / waitlist subcollections (audit H1) ───────────────
    //    One doc per member, keyed by uid; volunteer names live here, never on
    //    the parent. Via a collectionGroup query a member reads only their OWN
    //    doc (the {path=**} rules). Via the church-scoped path rules, admin and
    //    manager always read the full roster, and regular members read it when
    //    the jobsRosterVisibility setting permits (canSeeJobRoster). Writes are
    //    Cloud Functions only (Admin SDK bypasses these rules).
    match /{path=**}/signups/{signupId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }
    match /{path=**}/waitlist/{waitlistId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }
    match /churches/{churchId}/jobListings/{jobId}/signups/{signupId} {
      allow read:  if canSeeJobRoster(churchId, jobId);
      allow write: if false;
    }
    match /churches/{churchId}/jobListings/{jobId}/waitlist/{waitlistId} {
      allow read:  if canSeeJobRoster(churchId, jobId);
      allow write: if false;
    }

    // ── Job Hub — swap requests: members create own; admins+mgrs read+delete; member can delete own ──
    //    Audit L4: the create is bounded — exact key allowlist, uid pinned to
    //    the caller, name pinned to the caller's own user-doc name (no
    //    impersonation in this admin-read field; userData() reuses the
    //    request's single get), and the free-text note capped at 1000 chars.
    match /churches/{churchId}/jobSwapRequests/{docId} {
      // Members can read their own pending requests so the UI can offer a
      // "Withdraw Request" affordance (UI audit Phase 5). Admins/managers
      // still see every request for triage.
      allow read:   if isChurchAdminOrManager(churchId)
                    || (isMember(churchId) && resource.data.uid == request.auth.uid);
      allow create: if canUseJobsHub(churchId)
        && request.resource.data.keys().hasOnly(['jobDocId', 'uid', 'name', 'note', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == userData().get('name', '')
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000;
      allow delete: if isChurchAdminOrManager(churchId) || (isMember(churchId) && resource.data.uid == request.auth.uid);
    }

    // ── Job Hub — announcements: members (with hub access) read; admins+mgrs write ──
    //    Identity + audit fields are immutable on edit (audit M7, mirrors the
    //    hardened jobListings update rule).
    match /churches/{churchId}/jobAnnouncements/{docId} {
      allow read:           if canUseJobsHub(churchId);
      allow create, delete: if isChurchAdminOrManager(churchId) && jobsHubActive(churchId);
      allow update:         if isChurchAdminOrManager(churchId)
        && jobsHubActive(churchId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'createdBy', 'createdByName', 'createdAt'
           ]);
    }

    // ── Rooms/Spaces — members read; admins+mgrs write ────────────────────────
    match /churches/{churchId}/rooms/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Vendors ───────────────────────────────────────────────────────────────
    match /churches/{churchId}/vendors/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Bundles ───────────────────────────────────────────────────────────────
    match /churches/{churchId}/bundles/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Audits ────────────────────────────────────────────────────────────────
    match /churches/{churchId}/audits/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Access People ─────────────────────────────────────────────────────────
    match /churches/{churchId}/accessPeople/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Access Records ────────────────────────────────────────────────────────
    match /churches/{churchId}/accessRecords/{docId} {
      allow read:  if isMember(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Shepherd Hub people cache ────────────────────────────────────────────
    //    Cloud-Function-written mirror of Planning Center people. Read = elders
    //    (custom claim) or church admin (P1 lock retained for support/debug —
    //    the Level-1 privacy model already accepts admin readability of this
    //    PCO-sourced data). NO client write (Admin SDK / sync CF only). Holds
    //    sensitive pastoral data incl. medical_notes.
    match /churches/{churchId}/shepherdPeople/{docId} {
      allow read:  if isElder() || isChurchAdmin(churchId);
      allow write: if false;
    }

    // ── Private pastoral note — one per (person, elder); doc id = the elder's
    //    uid. Only the owning elder may read or write it — private even from
    //    other elders and from admins (Level 1: enforced by rules; Level 2
    //    client-side encryption is the fast-follow). ─────────────────────────
    match /churches/{churchId}/shepherdPeople/{personId}/privateNotes/{ownerUid} {
      allow read, write: if isElder() && request.auth.uid == ownerUid;
    }

    // ── Shared care thread — any elder reads/appends; entries are author-owned
    //    (author or, for cleanup, a church admin may edit/delete). Admins do not
    //    read by default (elders-only space). ─────────────────────────────────
    match /churches/{churchId}/shepherdPeople/{personId}/careThread/{entryId} {
      allow read:   if isElder();
      allow create: if isElder() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isElder() && resource.data.authorUid == request.auth.uid;
    }

    // ── Shepherd audit log — every note view/edit + reassignment. Append-only;
    //    readable by elders + admin; each entry stamped with the actor. ────────
    match /churches/{churchId}/shepherdAudit/{entryId} {
      allow read:   if isElder() || isChurchAdmin(churchId);
      allow create: if (isElder() || isChurchAdmin(churchId)) && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Time Entries (contractor / labor hours) — payroll-sensitive, so
    //    admin/manager only for both read and write. (Contractor self-logging
    //    is a deferred follow-up; it would relax create for a linked user.)
    match /churches/{churchId}/timeEntries/{docId} {
      allow read:  if isChurchAdminOrManager(churchId);
      allow write: if isChurchAdminOrManager(churchId);
    }

    // ── Public requests — anyone can submit; only church members can read/dismiss ──
    //    create is unauthenticated by design (public item-request form); audit L6
    //    bounds it with an exact key allowlist + length caps so it can't be used
    //    as an arbitrary-blob spam / Firestore-cost vector.
    match /churches/{churchId}/publicRequests/{docId} {
      allow create: if request.resource.data.keys().hasOnly([
                         'name', 'email', 'phone', 'itemDescription', 'quantity',
                         'dateNeeded', 'urgency', 'notes', 'status', 'submittedAt'
                       ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.itemDescription is string
        && request.resource.data.itemDescription.size() > 0
        && request.resource.data.itemDescription.size() <= 2000
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.status == 'pending';
      allow read, update, delete: if request.auth != null && userChurchId() == churchId;
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        userChurchId() == resource.data.churchId
      );

      // New users can create their own profile.
      // Church creators may set role 'admin' only for their own church.
      // All other new registrations must set role 'user' (prevents self-escalation at signup).
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (
          request.resource.data.role == 'user'
          || (
            request.resource.data.role == 'admin'
            && request.resource.data.churchId == request.auth.uid + '-church'
          )
        );

      // Self-updates are allowed but cannot change role, churchId, active, or allowedHubs.
      // Admins in the same church can update role, active, allowedHubs, etc. — but cannot
      // change another user's phone, smsRemindersEnabled, or smsNewJobsEnabled
      // (TCPA: every SMS opt-in must be the user's own).
      // C-01: admins also CANNOT change churchId. Without this pin an admin could transplant
      // any user (or themselves) into another church, defeating multi-tenant isolation.
      allow update: if request.auth != null && (
        (
          request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.churchId == resource.data.churchId
          && request.resource.data.active == resource.data.active
          && request.resource.data.get('allowedHubs', null) == resource.data.get('allowedHubs', null)
        )
        || (
          userIsAdmin()
          && userChurchId() == resource.data.churchId
          && request.resource.data.churchId == resource.data.churchId
          && request.resource.data.get('phone', '') == resource.data.get('phone', '')
          && request.resource.data.get('smsRemindersEnabled', false) == resource.data.get('smsRemindersEnabled', false)
          && request.resource.data.get('smsNewJobsEnabled', false) == resource.data.get('smsNewJobsEnabled', false)
        )
      );

      // Self-delete or admin in same church
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        (userIsAdmin() && userChurchId() == resource.data.churchId)
      );
    }

    // ── Suggestions — any authenticated user can submit; owner-only read ──────
    // NOTE: owner emails also defined in functions/index.js (OWNER_EMAILS) and SettingsPage.jsx (isOwner). Keep in sync.
    match /suggestions/{docId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
    }

    // ── SMS opt-out audit log — Admin SDK writes only; owner-only read ────────
    // Populated by twilioInbound CF when users reply STOP/START. Retained
    // indefinitely per Privacy Policy commitment to honor opt-out requests.
    match /smsOptOuts/{docId} {
      allow read: if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
      allow create, update, delete: if false;
    }

    // ── Email suppression list (F-38) — Admin SDK writes only; owner-only read
    // Populated by sendgridEventWebhook when SendGrid reports bounce, dropped,
    // spamreport, or unsubscribe events. Read by sendEmailSafe before every
    // outbound message. Manually set `active: false` to un-suppress an address.
    match /emailSuppressions/{docId} {
      allow read: if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
      allow create, update, delete: if false;
    }

    // ── Email event audit log (F-38) — every SendGrid event lands here.
    match /emailEvents/{docId} {
      allow read: if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
      allow create, update, delete: if false;
    }

    // ── Notifications (in-app inbox) — a member reads/updates/deletes only
    //    their OWN notifications. Create is Admin-SDK-only (the deliverNotification
    //    helper / notify callable) — clients never write these directly.
    match /churches/{churchId}/notifications/{docId} {
      allow read:   if isMember(churchId) && (resource == null || resource.data.recipientUid == request.auth.uid);
      allow update: if isMember(churchId) && resource.data.recipientUid == request.auth.uid
                    && request.resource.data.recipientUid == resource.data.recipientUid;
      allow delete: if isMember(churchId) && resource.data.recipientUid == request.auth.uid;
      allow create: if false;
    }

    // ── App-wide banner (maintenance / announcements) — any signed-in user
    //    reads; owner-only writes. Drives the GlobalBanner in the app shell and
    //    the "we're updating" notice during migration windows.
    //    NOTE: owner emails also in functions/index.js (OWNER_EMAILS) and
    //    SettingsPage.jsx (isOwner). Keep in sync.
    match /appConfig/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email in ['jcvaught@gmail.com', 'jvaught@fxcc.org'];
    }

    // ── Errors (audit M5) — no client error-telemetry collection exists;
    //    Sentry (@sentry/react) handles all error reporting. This explicit
    //    deny makes the absence intentional: any future feature that needs an
    //    `errors` collection must add a considered rule rather than silently
    //    inherit access from a default. Do not relax without a real consumer.
    match /errors/{docId} {
      allow read, write: if false;
    }

  }
}
