rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // PHASE 1: Simple team access (no auth required)
    // Anyone with the link can read/write.
    // This is fine for a small trusted team.
    // =============================================
    match /churches/{churchId}/{document=**} {
      allow read, write: if true;
    }

    // =============================================
    // PHASE 2: When you add authentication, replace
    // the rules above with these:
    //
    // match /churches/{churchId}/{document=**} {
    //   allow read, write: if request.auth != null
    //     && exists(/databases/$(database)/documents/churches/$(churchId)/members/$(request.auth.uid));
    // }
    // =============================================
  }
}
