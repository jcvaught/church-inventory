{
  "name": "churchopshub",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_ENV=production rm -rf node_modules/.vite && vite build",
    "postbuild": "node scripts/prerender-blog.mjs && node scripts/prerender-static.mjs && node scripts/verify-prod-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "analyze": "ANALYZE=true vite build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@sentry/react": "^10.43.0",
    "@zxing/browser": "^0.1.5",
    "firebase": "^12.13.0",
    "posthog-js": "^1.373.4",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "firebase-admin": "^13.9.0",
    "firebase-tools": "^15.10.0",
    "globals": "^17.4.0",
    "marked": "^13.0.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "terser": "^5.46.1",
    "typescript": "^5.9.3",
    "vite": "^5.1.0"
  }
}
